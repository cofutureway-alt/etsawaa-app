    "@types/node": "^24.10.1",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "chrome-launcher": "^1.2.2",
    "lighthouse": "^13.6.0",
    "oxlint": "^1.29.0",
    "playwright-core": "^1.64.1",
    "puppeteer-core": "^25.16.0",
