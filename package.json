  "type": "module",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "start": "node --env-file=.env node_modules/@react-router/serve/bin.js ./build/server/index.js",
    "typecheck": "react-router typegen && tsc",
    "lint": "oxlint app scripts tests",
    "test": "node --import tsx --test tests/compare.test.ts tests/phone.test.ts tests/permissions.test.ts tests/tokens.test.ts tests/i18n-keys.test.ts tests/auth-schemas.test.ts tests/otp-cooldown.test.ts tests/money.test.ts tests/pricing.test.ts tests/next.test.ts tests/postgrest.test.ts tests/session-headers.test.ts tests/variant.test.ts tests/coupon-scopes.test.ts tests/email-template.test.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@hookform/resolvers": "^5.2.2",
    "@react-router/node": "^7.9.6",
    "@react-router/serve": "^7.9.6",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.87.1",
    "@types/leaflet": "^1.9.22",
    "bwip-js": "^4.11.4",
    "i18next": "^25.7.2",
    "isbot": "^5.1.31",
    "leaflet": "^1.9.4",
    "react": "^19.2.1",
    "react-dom": "^19.2.1",
    "react-dropzone": "^20.1.4",
    "react-hook-form": "^7.66.1",
    "react-i18next": "^16.2.4",
    "react-router": "^7.9.6",
    "zod": "^4.1.13"
  },
