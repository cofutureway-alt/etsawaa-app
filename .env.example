# Supabase (project URL + anon key are safe for the browser by design)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (F-18). Leave empty to run without a provider:
# sendEmail() then reports a configuration error instead of silently "sending".
RESEND_API_KEY=
EMAIL_FROM="Etsawaa <no-reply@etsawaa.com>"

# Public site URL used for OAuth redirect and canonical links
SITE_URL=http://localhost:3000

# Kashier payment gateway (phase 05) — without these the card method is
# unavailable at checkout and only COD works
KASHIER_MERCHANT_ID=
KASHIER_HMAC_SECRET=
KASHIER_MODE=test
# KASHIER_BASE_URL=https://checkout.kashier.io

# Tooling-only (scripts/apply-migration.mjs, scripts/rls-audit.mjs).
# Management API token with full SQL access — never ship, never commit.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
PORT=3000

# Local test credentials for scripts/hardening-*.mjs (never commit values)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
