# Supabase (project URL + anon key are safe for the browser by design)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Server-only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=

# Transactional email (F-18) through our own mail server (Stalwart, mx.etsawaa.com).
# Leave a mailbox empty to run without it: sendEmail() then reports a
# configuration error instead of silently "sending".
# Auth codes use the signed Send Email Hook and the same branded renderer.
# Separate 32-byte base64 encryption key; keep it stable when rotating hook secrets.
AUTH_EMAIL_HOOK_SECRET=
AUTH_EMAIL_ENCRYPTION_KEY=
AUTH_EMAIL_OTP_EXP=3600
SMTP_HOST=mx.etsawaa.com
SMTP_PORT=465
SMTP_NOTIFY_USER=notifications@etsawaa.com
SMTP_NOTIFY_PASS=
EMAIL_FROM_NOTIFY="Etsawaa <notifications@etsawaa.com>"
SMTP_SUPPORT_USER=support@etsawaa.com
SMTP_SUPPORT_PASS=
EMAIL_FROM_SUPPORT="Etsawaa Support <support@etsawaa.com>"
EMAIL_REPLY_TO=support@etsawaa.com

# Public site URL used for OAuth redirect and canonical links
SITE_URL=http://localhost:3000

# Kashier payment gateway (phase 05) — without these the card method is
# unavailable at checkout and only COD works
# Kashier — Merchant ID + both key pairs (dashboard → Integrations). The live /
# test switch is the admin setting "Payments → Kashier test mode", not an env var.
# Escape the "$" inside secret keys as \$ (dev server expands $NAME otherwise).
KASHIER_MERCHANT_ID=
KASHIER_LIVE_API_KEY=
KASHIER_LIVE_SECRET_KEY=
KASHIER_TEST_API_KEY=
KASHIER_TEST_SECRET_KEY=

# Tooling-only (scripts/apply-migration.mjs, scripts/rls-audit.mjs).
# Management API token with full SQL access — never ship, never commit.
SUPABASE_ACCESS_TOKEN=
SUPABASE_PROJECT_REF=
PORT=3000
# Number of reverse proxies in front of the app (e.g. 1 behind one load
# balancer). Enables per-IP rate limits from X-Forwarded-For; leave 0 when the
# app is exposed directly, since the header is then client-forgeable.
TRUSTED_PROXY_HOPS=0

# Local test credentials for scripts/hardening-*.mjs (never commit values)
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=
